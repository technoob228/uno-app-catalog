{
	admin off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	# Пригласительная ссылка: cookie на 30 дней → страница регистрации.
	@invite path /uno-invite/{$INVITE_KEY}
	handle @invite {
		header Set-Cookie "uno_invite={$INVITE_KEY}; Path=/; Max-Age=2592000; Secure; HttpOnly; SameSite=Lax"
		redir * /register 302
	}

	# Регистрация без приглашения закрыта.
	@signup_closed {
		path /api/v1/register /api/v1/register/*
		not header_regexp Cookie (^|;\s*)uno_invite={$INVITE_KEY}(;|$)
	}
	handle @signup_closed {
		header Content-Type application/json
		respond `{"code":403,"message":"Sign-ups are by invitation only. Ask the owner for the invite link."}` 403
	}

	handle {
		reverse_proxy vikunja:3456
	}
}
